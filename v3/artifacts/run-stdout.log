[2026-10-01 10:50:30,785] INFO - src.agent_red.agent.ide_solver - [INFO] 2026-10-01 10:50:30,704 - automation_server.core.executor - INFO - Executing script: # opencode >=1.18 stores sessions in a SQLite DB (opencode.db); read
# the latest session id from it rather than the removed JSON files.
session_id=$(python3 -c "import sqlite3,os;db=os.path.expanduser('~/.local/share/opencode/opencode.db');c=sqlite3.connect(db);r=c.execute('SELECT id FROM session ORDER BY time_updated DESC LIMIT 1').fetchone();print(r[0] if r else '')" 2>/dev/null)
if [ -n "$session_id" ]; then
  mkdir -p "$(dirname "/home/devuser/.local/share/opencode/latest_export.json")"
  opencode export "$session_id" > "/home/devuser/.local/share/opencode/latest_export.json" 2>/tmp/opencode_export.err || true
fi

